<!-- HERO -->
<section id="home">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-circle"></div>
    <div class="hero-bg-circle2"></div>
    <div class="hero-bg-line"></div>
  </div>
  <div class="hero-content">
    <div class="hero-eyebrow">Boutique de Inteligência Executiva</div>
    <h1 class="hero-title fade-up">
      Governança,<br>Dados<br>e <em>Decisão.</em>
    </h1>
    <p class="hero-subtitle fade-up delay-1">
      Transformamos dados operacionais, financeiros e de risco em inteligência para o Conselho e a Alta Gestão. Antes que os problemas apareçam nos resultados.
    </p>
    <div class="hero-actions fade-up delay-2">
      <a href="#solucoes" class="btn-primary">Conhecer Soluções</a>
      <a href="#board" class="btn-ghost">Método S.I.N.A.L.</a>

<meta property="og:title" content="Toledo Board Intelligence — Governança, Dados e Decisão.">
<meta property="og:description" content="Transformamos dados operacionais, financeiros e de risco em inteligência para o Conselho e a Alta Gestão. Antes que os problemas apareçam nos resultados.">
<meta property="og:image" content="assets/logo/logo.png">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="assets/logo/favicon.png">
